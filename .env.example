# APP_ENV/APP_DEBUG below are LOCAL-DEV values, not something to copy
# as-is into production. APP_DEBUG=true means an unhandled error shows a
# full stack trace (file paths, query bindings, sometimes config values)
# to whoever triggered it — exactly what you want while developing on
# your own machine, and exactly what you don't want a stranger hitting a
# bug on the live site to see. On Railway (or any real deployment), set
# APP_ENV=production and APP_DEBUG=false.
APP_NAME="DocTrack"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL (works out-of-the-box with XAMPP/Laragon + phpMyAdmin) ---
# Create a database matching DB_DATABASE first, then fill in your own
# credentials below — these are placeholders, not real values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=docuwise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Blank/unset here defaults to false, which is correct for local dev over
# plain http:// — the browser will still send the session cookie either
# way. On Railway (or any production domain served over https://), set
# this to true instead, so the browser refuses to send the login session
# cookie over anything BUT an encrypted connection — without it, the
# cookie that keeps someone logged in could be intercepted on an
# unencrypted network.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb

# --- Email (see README "Continuous operation" §2.6) ---
# 'log' writes emails to storage/logs/laravel.log instead of sending them —
# works out of the box for a demo/dev setup, no account needed. Replace with
# real smtp+MAIL_HOST/PORT/USERNAME/PASSWORD credentials for production.
MAIL_MAILER=log

FILESYSTEM_DISK=local

# --- File storage on Railway (local disk is ephemeral there — uploaded
# documents/ML model files would be lost on every redeploy). To use
# Cloudflare R2 instead (S3-API-compatible, so no code changes needed —
# see league/flysystem-aws-s3-v3 in composer.json): set FILESYSTEM_DISK=s3
# above and fill these in from your R2 bucket (Cloudflare dashboard → R2 →
# Manage API Tokens for the key/secret, and the bucket's own page for the
# endpoint URL). AWS_DEFAULT_REGION is always "auto" for R2 regardless of
# where the bucket actually lives. Leave all blank/unset while
# FILESYSTEM_DISK=local (the default, e.g. for local dev). ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Backups (see README "Continuous operation" §2.4) ---
BACKUP_KEEP=14

# --- Error monitoring (Sentry) — see bootstrap/app.php's withExceptions()
# and config/sentry.php. Leaving this blank is safe: the SDK silently
# no-ops with no DSN set, which is the right default for local dev — you
# don't want your own local exceptions cluttering a shared Sentry project.
# Get a DSN from sentry.io (free tier) → create a Laravel project → Settings
# → Client Keys (DSN). Only set this in production. ---
SENTRY_LARAVEL_DSN=

# --- Reverb WebSocket server, for live dashboard/notification push
# (README §2.5) — run `php artisan reverb:install` to generate real
# per-installation values for REVERB_APP_ID/KEY/SECRET below; these are
# blank placeholders, not something to leave as-is.
#
# The four values below (HOST/PORT/SCHEME + the client can't reach the
# server) are the specific ones that cost real deployment time in this
# project's own history — they are LOCAL-DEV defaults, and production
# needs genuinely different values, not just "fill in the ID/key/secret
# and go":
#
#   LOCAL:      REVERB_HOST=localhost        REVERB_PORT=8080  REVERB_SCHEME=http
#   PRODUCTION: REVERB_HOST=<your public domain, e.g. myapp.up.railway.app>
#               REVERB_PORT=443               REVERB_SCHEME=https
#
# Why: a platform like Railway terminates TLS at its own edge and proxies
# plain HTTP to this container — Reverb itself still listens on plain HTTP
# internally regardless of environment, but the BROWSER connects to the
# public HTTPS domain on port 443, not to the container's internal port
# directly. Setting REVERB_HOST to "localhost" (or leaving REVERB_SCHEME as
# http) in production silently breaks realtime push — the app still works,
# it just falls back to polling with no obvious error message pointing at
# these four values as the cause. ---
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OCR + PDF extraction packages (smalot/pdfparser, thiagoalessio/tesseract_ocr)
# are already required in composer.json — `composer install` gets them.
# The system tesseract-ocr binary they shell out to for scanned-image OCR is
# either installed normally (apt/Windows) or falls back automatically to the
# bundled copy at storage/tesseract-bin — see README §2.3.
